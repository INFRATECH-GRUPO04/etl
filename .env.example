# Nome do bucket
S3_BUCKET='nome-do-seu-bucket'

# Prefixos dos dados no mesmo bucket
S3_BRONZE_PREFIX=01-bronze/
S3_SILVER_PREFIX=02-silver/
S3_GOLD_PREFIX=03-gold/

# Fuso usado nos rótulos e nos horários gravados no gold
TIMEZONE=America/Sao_Paulo

# Opcional: bucket pessoal para gravar só o gold (testes). Se vazio, usa S3_BUCKET.
# S3_GOLD_BUCKET='nome-do-seu-bucket-de-teste'

# ============================================================
# AWS / S3 - credenciais OPCIONAIS
# Na EC2/Lambda com IAM Role: deixe as credenciais comentadas; o boto3 usa a role.
# Fora da AWS: use UMA das duas formas abaixo.
# Nunca preencha só AWS_ACCESS_KEY_ID sem AWS_SECRET_ACCESS_KEY.
# ------------------------------------------------------------
AWS_REGION=us-east-1
# AWS_DEFAULT_REGION=us-east-1

# Forma 1: credenciais diretas (SESSION_TOKEN só se vier de STS)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Forma 2: perfil compartilhado (~/.aws/credentials e ~/.aws/config)
# AWS_PROFILE=
# AWS_SHARED_CREDENTIALS_FILE=
# AWS_CONFIG_FILE=

# Regras de monitoramento
OFFLINE_TIMEOUT_SECONDS=2400
FREQUENCIA_ESPERADA_SEGUNDOS=60

# Intervalos usados nos cálculos de rede (segundos)
# REDE_MAX_INTERVAL_SECONDS=90
# REDE_SARAH_MAX_INTERVAL_SECONDS=180
# REDE_QA_MAX_INTERVAL_SECONDS=120

# Limites de cálculo do dash-qa
# LIMITE_CRITICO_CPU_PCT=90
# CAPACIDADE_REDE_MBPS=100
