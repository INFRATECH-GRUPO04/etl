# Nome do bucket
S3_BUCKET='nome-do-seu-bucket'

# Prefixos dos dados no mesmo bucket
S3_BRONZE_PREFIX=01-bronze/
S3_SILVER_PREFIX=02-silver/
S3_GOLD_PREFIX=03-gold/

# Região é opcional se já estiver configurada no ambiente/SDK.
# Não coloque AWS_ACCESS_KEY_ID nem AWS_SECRET_ACCESS_KEY na EC2 com IAM Role.
# AWS_REGION=sa-east-1

# Regras de monitoramento
OFFLINE_TIMEOUT_SECONDS=30
LIMITE_CPU_PCT=80
LIMITE_RAM_PCT=80
LIMITE_DISCO_PCT=80
